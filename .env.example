# =============================================================================
# 复制成 .env 后按需修改：  cp .env.example .env
# 注意：.env 里不支持行内注释，注释必须单独占一行
# =============================================================================

COMPOSE_PROJECT_NAME=fspa
TAG=latest

# ------------------------------ 必改：密码 ------------------------------
MYSQL_ROOT_PASSWORD=ChangeMe_Mysql_2026
REDIS_PASSWORD=ChangeMe_Redis_2026

# ------------------------------ 对外端口 ------------------------------
# 只对外开这一个端口，三套前端按路径区分：
#   http://IP:13999/        入口导航页
#   http://IP:13999/web/    品牌官网
#   http://IP:13999/h5/     用户端 H5
#   http://IP:13999/admin/  运营管理后台
#   http://IP:13999/healthz 健康检查
# 服务器这个端口已被占用时改这里即可，前端不用重新打包（都是同源相对路径）
HTTP_PORT=13999

# ------------------------------ JVM ------------------------------
# 服务器内存 4G 以下建议 front/admin 各给 768m
JAVA_OPTS_FRONT="-Xms512m -Xmx1024m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError"
JAVA_OPTS_ADMIN="-Xms512m -Xmx1024m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError"

# ------------------------------ 阿里云短信 ------------------------------
# 不需要短信功能可以留空；管理端与前台是两个不同的阿里云账号
ALIYUN_ACCESSKEY=
ALIYUN_ACCESSKEYSECRET=
ALIYUN_FRONT_ACCESSKEY=
ALIYUN_FRONT_ACCESSKEYSECRET=
